      "size": 14.5,
      "bounds": [
        48.464,
        283.7695,
        292.7455,
        298.893
      ]
    },
    {
      "page": 2,
      "id": "paragraph.0",
      "text": "swirling clouds, and the Great Red Spot is",
      "font": "Body",
      "size": 14.5,
      "bounds": [
        48.464,
        304.958,
        326.73349999999994,
        320.125
      ]
    },

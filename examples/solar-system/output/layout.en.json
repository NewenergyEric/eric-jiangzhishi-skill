        521.958,
        297.05199999999996,
        536.8205
      ]
    },
    {
      "page": 2,
      "id": "paragraph.2",
      "text": "beyond it, taking about 165 Earth years to",
      "font": "Body",
      "size": 14.5,
      "bounds": [
        49.334,
        542.958,
        328.61850000000004,
        558.125

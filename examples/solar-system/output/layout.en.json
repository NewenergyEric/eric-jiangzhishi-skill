      "page": 2,
      "id": "paragraph.1",
      "text": "solid surface to stand on like Earth's.",
      "font": "Body",
      "size": 14.5,
      "bounds": [
        48.464,
        465.7695,
        294.34049999999996,
        477.6885
      ]
    },
